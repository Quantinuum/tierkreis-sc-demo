{
  "typeCheckingMode": "strict",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["src/fmo_vqe", "tkr/graphs", "tkr/workers"],
  "exclude": ["**/api/api.py"],
  "reportMissingTypeStubs": false,
  "executionEnvironments": [
    {"root": "src/fmo_vqe", "reportUnknownVariableType": false, "reportUnknownMemberType": false, "reportUnknownArgumentType": false},
    {"root": "tkr/graphs", "reportUnknownVariableType": false, "reportUnknownMemberType": false},
    {"root": "tkr/workers", "reportUnknownVariableType": false, "reportUnknownMemberType": false, "reportUnknownArgumentType": false}
  ]
}